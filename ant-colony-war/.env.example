# The narrator is a local British boy voice by default (no account needed).
# Optional tweaks:
# VOICE_SEMITONES=5     # higher = younger, lower = older
# VOICE_SPEED=0.92      # lower = slower
#
# To use ElevenLabs instead:
# TTS_ENGINE=elevenlabs
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=   # run `npm run voices` to list yours

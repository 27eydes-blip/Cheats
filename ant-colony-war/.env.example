# The narrator is a local older-British-boy voice by default (no account needed).
# Optional tweaks:
# VOICE_SEMITONES=0     # + younger, - older
# VOICE_SPEED=0.78      # lower = slower
#
# To use ElevenLabs instead:
# TTS_ENGINE=elevenlabs
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=   # run `npm run voices` to list yours

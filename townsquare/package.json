{
  "name": "world-net-news",
  "version": "0.1.0",
  "private": true,
  "description": "Social + news platform by Gleyde Technologies, LLC",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "seed": "tsx scripts/seed.ts",
    "reset": "rm -rf data && npm run seed",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:visual": "playwright test --trace off",
    "test:visual:update": "playwright test --trace off --update-snapshots",
    "start:server": "tsx scripts/seed.ts && npm start",
    "teams:refresh": "tsx scripts/refresh-team-logos.ts",
    "news:ingest": "tsx scripts/ingest.ts",
    "push:keys": "tsx scripts/push-keys.ts"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/newsreader": "^5.3.0",
    "fast-xml-parser": "5.12.0",
    "fflate": "^0.8.2",
    "next": "^15.5.29",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "tsx": "^4.20.6",
    "web-push": "3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.17",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}

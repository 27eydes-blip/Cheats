# Copy to .env.local and fill in. Never commit real values.

# Public URL of the app (used for OAuth redirects and share links)
APP_URL=http://localhost:3000

# Local SQLite file (default: ./data/app.db). Swap for Supabase later.
DATABASE_PATH=./data/app.db
# Where uploaded images are stored (private; served through /api/media with access checks)
UPLOAD_DIR=./data/uploads

# Comma-separated emails that become admins when they sign up
ADMIN_EMAILS=

# Google sign-in (optional). Create OAuth credentials at console.cloud.google.com
# Authorized redirect URI: ${APP_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Supabase (Stage 2+ swap-in; not used yet)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Markets page (optional). Free key at finnhub.io. Without it, /markets runs in
# clearly labeled DEMO mode with simulated prices.
FINNHUB_API_KEY=

# Sports team logos (optional). Only use a provider you are licensed to use.
# Without these, the site shows generated badges in each team's colors.
# SPORTS_LOGO_PROVIDER: none | manifest  (add vendors in src/lib/sports/logo-provider.ts)
SPORTS_LOGO_PROVIDER=none
SPORTS_API_KEY=
# For the "manifest" provider: your vendor's JSON feed of team id -> logo URL
SPORTS_LOGO_MANIFEST_URL=

# Optional features (off unless set to 1)
# Shows the placeholder Wallet page and menu item. No payments code exists yet.
NEXT_PUBLIC_FEATURE_WALLET=

# ---------------------------------------------------------------- real news
# Licensed news API for outlets without public feeds (AP, Reuters). NewsAPI.org
# format. Without it, those two outlets are skipped; the 50+ RSS feeds still work.
NEWS_API_KEY=
# Minutes between feed syncs (default 10) and between news-API calls (default 20,
# so a 100-calls-a-day plan isn't exceeded).
NEWS_INGEST_INTERVAL_MIN=10
NEWS_API_INTERVAL_MIN=20
# Set to "off" to stop the built-in scheduler (e.g. if you run `npm run news:ingest`
# from a separate cron service instead).
NEWS_INGEST=
# Local testing only: show the fictional demo stories even in production mode.
# Never set this on Railway.
NEWS_DEMO=

# ---------------------------------------------------------------- push alerts
# Make a key pair with `npm run push:keys`. Keep the private key secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: address or https URL push services can use to reach you (defaults to APP_URL).
VAPID_SUBJECT=
# Story importance (0-100) that sends an automatic breaking alert (default 85),
# and the minimum importance for followed-topic alerts (default 55).
BREAKING_AUTO_SCORE=85
FOLLOW_ALERT_SCORE=55

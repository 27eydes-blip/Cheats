// Glydaway on Cloudflare Pages (project "glydaway", custom domain glydaway.com). The game is one
// file, so the "build" just copies index.html into dist/. GitHub Actions (.github/workflows/glydaway.yml)
// runs the tests and deploys on every push to main that changes glydaway/. By hand, from this folder:
//   rm -rf dist && mkdir -p dist/icons && cp index.html dist/ && cp icons/*.png dist/icons/ && npx wrangler pages deploy dist --project-name=glydaway --branch=main
// Separate from every other project in this repo.
{
  "name": "glydaway",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-11-01"
}

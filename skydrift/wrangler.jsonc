{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skydrift-isles",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  // Local dev uses a local D1 file. Before deploying, run `npx wrangler d1 create skydrift-db`
  // and paste the database_id it prints here.
  "d1_databases": [
    { "binding": "DB", "database_name": "skydrift-db", "database_id": "00000000-0000-4000-8000-0000000000aa", "migrations_dir": "migrations" }
  ]
  // ADMIN_TOKEN: local dev reads it from .dev.vars; production: `npx wrangler secret put ADMIN_TOKEN`.
}

{
  "name": "jericho",
  "version": "0.1.0",
  "private": true,
  "description": "Personal voice assistant: browser ears, Claude brain, ElevenLabs voice.",
  "type": "module",
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "start": "node server/index.js",
    "start:safe": "node scripts/start-safe.mjs",
    "calls:setup": "node scripts/calls-setup.mjs",
    "tv:pair": "node scripts/tv-pair.mjs",
    "voice:check": "node scripts/voice-check.mjs",
    "plugs:test": "node scripts/plugs-test.mjs",
    "dev": "node --watch server/index.js",
    "test": "node --test test/*.test.js",
    "selftest": "node server/selftest.js",
    "make-cert": "mkdir -p certs && openssl req -x509 -newkey rsa:2048 -nodes -days 825 -keyout certs/key.pem -out certs/cert.pem -subj /CN=jericho.local"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "three": "^0.170.0",
    "tp-link-tapo-connect": "^2.0.15",
    "undici": "~7.30.2"
  },
  "overrides": {
    "tp-link-tapo-connect": {
      "axios": "^1.21.1",
      "uuid": "^11.1.1"
    }
  }
}

# Copy this file to .env and fill in your keys. .env is git-ignored.
# These are only ever read by the server; they are never sent to the browser.

ANTHROPIC_API_KEY=sk-ant-...
ELEVENLABS_API_KEY=...

# Optional: a password for the web page. Strongly recommended if you open
# Jericho from your phone or expose it outside localhost. Open the page once as
#   https://<laptop>:3000/?token=<this value>
# and the phone remembers it.
JERICHO_ACCESS_TOKEN=

# Phone calls (optional). Only needed when calls.testMode is false in settings.json.
# Never shared with the browser and blanked out of the action log.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Your own mobile, in +1XXXXXXXXXX form. Used as the callback number if a business
# asks for one, and calling it is allowed as a practice call.
MY_PHONE_NUMBER=

# Morning briefing calendar (optional): your calendar's private iCal link, read-only.
# Google Calendar: Settings > your calendar > Integrate calendar > "Secret address in iCal format".
# Outlook: Settings > Calendar > Shared calendars > Publish a calendar > ICS link.
# Apple iCloud: share the calendar as Public, then copy the webcal:// link.
# Treat it like a password: anyone with it can read your calendar. Jericho never logs or speaks it.
# Paste it right after the = on one line, no spaces (quotes are fine), e.g.
#   CALENDAR_ICS_URL=https://calendar.google.com/calendar/ical/.../private-.../basic.ics
# Then restart Jericho: the startup self-test shows "Calendar PASS" with today's number of events.
CALENDAR_ICS_URL=

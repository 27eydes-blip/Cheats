  "eval": "(async()=>{const g=window.__game,c=g.ctx,m=c.creatures,k=m.byId('sw_court');const V=c.player.position.constructor;c.time.hour=17.5;c.time.frozen=true;c.time.update(0);for(let i=0;i<200&&k.place.roof&&!k.homed;i++){c.player.teleport(new V(k.home.x+20,30,k.home.z));g.step(2);await new Promise(r=>setTimeout(r,0));}const p=new V(k.home.x+Math.cos(0.6)*9,k.home.y+0.1,k.home.z+Math.sin(0.6)*9);c.player.mode='foot';c.player.teleport(p);const look=()=>{const v=k.pos.clone().sub(c.player.position);c.player.yaw=Math.atan2(-v.x,-v.z);c.player.pitch=Math.atan2(v.y+0.4,Math.hypot(v.x,v.z))*0.8;};look();k.setState('warning','shot');k.threat=0.8;;for(let i=0;i<60;i++){g.step(1);k.state!=='warning'&&k.setState('warning','shot');c.player.position.copy(p);look();}})()"
 },

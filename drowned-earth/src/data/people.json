  "thanks": [
   "You pulled me out. I won't forget it.",
   "I'd be in the water still if it weren't for you.",
   "I owe you. Whatever you need."
  ],
  "resent": [
   "You stood there and watched.",
   "I saw you on the bridge. You didn't even shout."
  ],
  "injured": [
   "Still can't put weight on it. Doesn't matter. Work's work.",
   "The scar itches when it rains. Which is always."
  ],
  "grief": [
   "{dead} used to sit just there. I keep looking.",
   "They're saying it was the {creature}. I keep thinking: if I'd gone with {dead}…",
   "We buried {dead} at sea. Well. We gave {dead} back."
  ],
  "warn": [
   "Don't go near the {place}. Not after what happened.",
   "The {creature} at the {place} is nesting. Everybody knows. Well. Everybody does now."
  ],
  "gossip": [

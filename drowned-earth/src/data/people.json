   "{who} came back from the {place} with half a jar of glass and a limp.",
   "They say {who} went past the {creature} on purpose. Showing off."
  ],
  "argue": [
   "You owe me for the rope, {who}.",
   "That's my spot, {who}, and you know it.",
   "Say that again, {who}. Go on."
  ],
  "flirt": [

# Supabase project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Public URL of the app, used for OAuth redirects and share links
NEXT_PUBLIC_SITE_URL=https://your-app.example.com

# AI. Server-only, never exposed to the browser.
ANTHROPIC_API_KEY=sk-ant-...
# claude (default when ANTHROPIC_API_KEY is set) | mock (offline, dev/tests only)
AI_PROVIDER=claude

# Local testing only: shows an email sign-in on the login page. Leave unset in production.
# NEXT_PUBLIC_ENABLE_DEV_LOGIN=true

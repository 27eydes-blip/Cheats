{
  "name": "glydrift",
  "private": true,
  "version": "1.0.0",
  "description": "Glydrift \u2014 a neon-cosmos one-tap arcade flyer (Phaser 3 + Vite, Capacitor-ready).",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "ios:add": "npm run build && npx cap add ios",
    "ios:sync": "npm run build && npx cap sync ios",
    "ios:open": "npx cap open ios",
    "test:rls": "node scripts/test-leaderboard-rls.mjs",
    "deploy:pages": "npm run test:all && bash scripts/deploy-gh-pages.sh",
    "build:test": "GLY_TEST=1 vite build --outDir dist-test --emptyOutDir",
    "test:e2e": "playwright test",
    "test:all": "npm run build && npm run build:test && playwright test",
    "test:update": "npm run build && npm run build:test && playwright test --update-snapshots"
  },
  "dependencies": {
    "@capacitor-community/apple-sign-in": "7.1.0",
    "@capacitor/core": "^8.6.0",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "galmuri": "^2.40.3",
    "phaser": "3.90.0",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@playwright/test": "1.63.0",
    "vite": "^8.3.5"
  }
}

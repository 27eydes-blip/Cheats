{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coastpassgo",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Serve the app on your domains (coastpassgo.com is on this Cloudflare account).
  "routes": [
    { "pattern": "coastpassgo.com", "custom_domain": true },
    { "pattern": "www.coastpassgo.com", "custom_domain": true }
  ],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "townpass",
      // Replace with the id printed by `npx wrangler d1 create townpass`
      "database_id": "c53c6f3b-b159-4bb5-ba90-ec9f12fe5c83",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // QR codes encode this: keep it as the final domain once stickers are printed.
    "PUBLIC_BASE_URL": "https://coastpassgo.com",
    "BRAND_NAME": "CoastPassGo",
    "SUPPORT_EMAIL": "support@coastpassgo.com",
    "FROM_EMAIL": "CoastPassGo <access@coastpassgo.com>"
  }
  // Secrets (set with `npx wrangler secret put NAME`, never commit):
  //   STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, ACCESS_TOKEN_SECRET,
  //   ADMIN_PASSWORD, RESEND_API_KEY
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hunt",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "durable_objects": {
    "bindings": [
      { "name": "MATCH", "class_name": "MatchRoom" },
      { "name": "MATCHMAKER", "class_name": "Matchmaker" },
      { "name": "ZONE", "class_name": "ZoneRoom" },
      { "name": "DIRECTORY", "class_name": "Directory" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MatchRoom", "Matchmaker"] },
    { "tag": "v2", "new_sqlite_classes": ["ZoneRoom", "Directory"] }
  ]
}
